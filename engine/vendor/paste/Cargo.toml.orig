[package]
name = "paste"
version = "1.0.15"
authors = [
    "Aditya Kumar <git@adityais.dev>",
    "David Tolnay <dtolnay@gmail.com>",
]
categories = ["development-tools", "no-std", "no-std::no-alloc"]
description = "Compatibility shim: pastey 0.2.3 code packaged as paste 1.0.15 for unmodified dependents."
edition = "2018"
keywords = ["macros"]
license = "MIT OR Apache-2.0"
repository = "https://github.com/as1100k/pastey"
rust-version = "1.54"
include = ["CHANGELOG.md", "LICENSE-APACHE", "LICENSE-MIT", "README.md", "Cargo.toml", "src/**/*.rs"]

[workspace]
members =[
    "paste-compat",
    "pastey-test-suite",
]

[lib]
proc-macro = true

[package.metadata.docs.rs]
targets = ["x86_64-unknown-linux-gnu"]
rustdoc-args = ["--generate-link-to-definition"]

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(coverage_nightly)'] }
