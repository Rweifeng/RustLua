scene_version=2
name=api_tilemap
meta	display_name	Tilemap 与格子坐标
# GroundMap 是"场景声明的网格"：tiles / solid 各 100 个字符 = width(10) x height(10)，
# 逐格 row-major，y 朝上（row 0 画在地图最下面）。格子值 0=空、1=墙、3=地面，都是
# assets/textures/tileset.png 的列的采样。solid 是**独立的一层**（1=阻挡），与 tiles 无关。
# Walker 在 cell(2,2)、Target 在 cell(7,7)（两个格心 = 80,80 / 240,240）；cell y=3..6、x=5..6
# 的那堵内墙让 A* 必须绕行。实体名与 scripts/demo_tilemap.lua 里的 entity.find 一一对应。
