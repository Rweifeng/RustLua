component	12	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	12	UiEvents	event=pointer_enter;function=on_click;arg.name=hover_in|event=pointer_exit;function=on_click;arg.name=hover_out|event=pointer_down;function=on_click;arg.name=pressed|event=pointer_up;function=on_click;arg.name=released|event=click;function=on_click
component	12	UiLayout	anchors=0.0000,0.0000,0.0000,0.0000;offsets=-120.00,-24.00,120.00,24.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.0000,0.0000
