# ui_test —— 场景 UI 组件（Text / Image / UiLayout / Container / ButtonStates / UiEvents）的可交互演示。
#
# 这个演示想证明什么：
#   ① 屏幕空间 UI 的几何只由 `UiLayout`（四边 Anchor + Offset）与 `Container`（自动布局）给出；
#      Transform 一律留在原点——`scene_migration` 的父子语义门要求"子实体世界位置 == 局部位置"。
#   ② 按钮 = `Image + Text + UiEvents`（docs/30 §8）：点击由引擎 `process_ui_clicks` 命中
#      `UiEvents event=click` 的实体，再调用**工程级全局** `on_click(实体名)`
#      （scripts/main.lua → router → scripts/demo_ui_events.lua）。
#   ③ `Container` 的五种 kind 各出现一次：vbox（左侧按钮列）/ hbox（图例行）/ grid（2×2 图标）/
#      center（居中徽标）/ margin（内缩卡片）。容器按子实体 Image 的 UiLayout 尺寸摆放它们。
#   ④ `Image.nine_slice`（九宫格）：右侧 InfoPanel 用 button_green.png 的纹理像素边框，
#      渲染时拆成 3×3 共 9 格（不是单四边形拉伸）。
#   ⑤ `ButtonStates` 的五个视觉状态贴图覆盖：**只有编辑器 UI Designer 消费**——运行时渲染读的是
#      `Image.texture`，ButtonStates 既没有运行时消费方，也不会在鼠标悬停时切换。
#   ⑥ 本文件**刻意不写** `UiBindings` / `UiAnimation`：这两个组件只注册了 schema，
#      运行时 `typed_scene::compile_component` 没有它们的分支，写进场景会让
#      "组件必须被 typed 覆盖"的编译门判红。演示里"绑定的计数文本"由
#      scripts/demo_ui_events.lua 每帧用 `ui.text_at` 重画，"位移动画"也由脚本驱动。
#
# 两条布局约定（改这个文件前请先读）：
#   · 容器实体的 id 必须**小于**其子实体的 id —— 布局解算按实体 id 顺序自顶向下，容器先解算才能把
#     子实体摆到算出来的矩形上；id 反了子实体会用自己的 UiLayout 覆盖容器的摆放结果。
#   · 场景 UI 的绘制顺序 = 实体 id 顺序（全屏背景必须是最小的 id），且**所有 Text 画在所有 Image 之上**，
#     所以按钮文字可以放心地和按钮图片同处一块矩形。
#
# 被引擎测试固定引用的三处（不要改）：
#   · 实体 `StartButton` 存在且带 `UiEvents event=click;function=on_click`（点击要经 on_click 分发）；
#   · 场景产出 SDF 文字 draw（下面多处 font_size < 24 走 SDF 路径）；
#   · 文件里含 `assets/textures/slime.png`（`assetc` 的依赖改名门用它做消费者）。
scene_version=2
name=ui_test
# ① 全屏背景：UiLayout 的 anchors=0,0,1,1 + offsets=0,0,0,0 = 铺满设计分辨率 1280×720。
entity	1	BackdropPanel
# 背景是 **Quad**（世界/overlay 通道）而不是 Image：场景 `Image`/`Text` 永远画在 Lua 动态 UI
# 之上，铺满屏幕的 Image 会把脚本的读数（`api.title/status/hint` 与面板里的数值）整片盖住。
# Quad 走 2D 世界通道，动态 UI（ScreenUI）在它之上；默认 2D 相机中心 (640,360)、zoom 1，
# 因此 1280×720 的 Quad 恰好铺满屏幕。
component	1	Quad	size=1280,720;color=0.055,0.065,0.090,1
component	1	Transform	position=640.000000000,360.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
# ② 顶栏：只拉伸左右（anchors 右边界 = 1），高度由 offsets 的 top/bottom 直接给。
entity	2	HeaderBar
component	2	Image	texture=__white__;color=0.100,0.150,0.240
component	2	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	2	UiLayout	anchors=0.0000,0.0000,1.0000,0.0000;offsets=24.00,16.00,-24.00,72.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.5000,0.5000
# ③ 标题：**点锚**（四条 offsets 相等 → 零尺寸）——文字从该点开始画；长度 > 32 字符走 SDF 路径。
entity	3	TitleText
component	3	Text	text=ui_test - scene UI components and UiEvents clicks;font_size=20;color=0.930,0.960,1.000
component	3	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	3	UiLayout	anchors=0.0000,0.0000,0.0000,0.0000;offsets=48.00,32.00,48.00,32.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.0000,0.0000
# ④ 顶栏右侧的组件清单（Text 只是视觉属性，位置同样来自 UiLayout 的点锚）。
entity	4	HeaderComponentsText
component	4	Text	text=Image + Text + UiLayout + Container + ButtonStates + UiEvents;font_size=14;color=0.620,0.720,0.850
component	4	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	4	UiLayout	anchors=0.0000,0.0000,0.0000,0.0000;offsets=740.00,36.00,740.00,36.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.0000,0.0000
# ⑤ Container kind=vbox：左侧按钮列的**位置不是手写的**——下面 6 个按钮实体（id 6/8/10/12/14/16）
#    以它为父，容器按 padding=16,16,16,16、spacing=12、align=center 逐个摆放。
#    容器自身矩形：(60,120)-(340,560)；每个按钮 240×48 → 首个孩子落在 (80,136)，每个下移 60。
entity	5	ButtonColumn
component	5	Container	kind=vbox;padding=16.0000,16.0000,16.0000,16.0000;spacing=12.000000;columns=0;stretch=false;fill=false;align=center
component	5	Image	texture=__white__;color=0.088,0.108,0.155
component	5	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	5	UiLayout	anchors=0.0000,0.0000,0.0000,0.0000;offsets=60.00,120.00,340.00,560.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.0000,0.0000
# ⑥ StartButton：引擎测试点名要的实体。点击 → on_click("StartButton") → 计数 +1。
#    ButtonStates 写全五个状态（pressed 用内置白纹理表示"按下白闪"，disabled 用项目里的 red-1x1.png）；
#    这些贴图只有编辑器读，运行时渲染用的是上面 Image 的 __white__ + 颜色。
entity	6	StartButton	5
component	6	ButtonStates	normal=assets/textures/ui/button_green.png;hover=assets/textures/ui/button_green.png;pressed=__white__;disabled=assets/textures/red-1x1.png;focused=assets/textures/ui/button_green.png
component	6	Image	texture=__white__;color=0.160,0.420,0.720
component	6	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	6	UiEvents	event=click;function=on_click
component	6	UiLayout	anchors=0.0000,0.0000,0.0000,0.0000;offsets=-120.00,-24.00,120.00,24.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.0000,0.0000
# ⑦ 按钮文字是**子实体**：它的 UiLayout 锚点相对父矩形（按钮的 240×48）解析 → (12,17)，
#    于是文字始终贴在按钮左上角内侧，按钮被容器挪到哪都跟着走（不需要抄绝对坐标）。
entity	7	StartLabel	6
component	7	Text	text=Start +1;font_size=14;color=0.980,0.980,0.980
component	7	Transform	position=0.000000000,0.000000000,0.000000000;rotation=0.000000000,0.000000000,0.000000000,1.000000000;scale=1.000000000,1.000000000,1.000000000
component	7	UiLayout	anchors=0.0000,0.0000,0.0000,0.0000;offsets=12.00,17.00,12.00,17.00;min_size=0.00,0.00;max_size=0.00,0.00;pivot=0.0000,0.0000
