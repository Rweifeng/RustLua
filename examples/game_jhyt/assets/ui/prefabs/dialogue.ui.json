{
  "prefab_version": 1,
  "name": "dialogue",
  "owner": "dlg",
  "layout_source": "dialogue",
  "probe": { "portrait_w": 96, "portrait_h": 96 },
  "root": {
    "name": "panel",
    "type": "panel",
    "id": "dlg:box",
    "layout": {
      "preset": "top_left",
      "anchors": [0, 0, 0, 0],
      "offsets": { "left": 240, "top": 450, "right": 1040, "bottom": 690 }
    },
    "color": [0.10, 0.11, 0.15, 0.92],
    "children": [
      {
        "name": "portrait_frame",
        "type": "image",
        "id": "dlg:portrait_frame",
        "texture": "portrait_frame",
        "when": "has_portrait",
        "layout": {
          "preset": "top_center",
          "anchors": [0.5, 0, 0.5, 0],
          "offsets": {
            "left": -64,
            "top": { "slot": "portrait_h", "scale": -1, "add": -22 },
            "right": 64,
            "bottom": { "slot": "portrait_h", "scale": -1, "add": 106 }
          }
        }
      },
      {
        "name": "portrait",
        "type": "image",
        "id": "dlg:portrait",
        "path_slot": "portrait_tex",
        "layout": {
          "preset": "top_center",
          "anchors": [0.5, 0, 0.5, 0],
          "offsets": {
            "left": { "slot": "portrait_w", "scale": -0.5 },
            "top": { "slot": "portrait_h", "scale": -1, "add": -6 },
            "right": { "slot": "portrait_w", "scale": 0.5 },
            "bottom": -6
          }
        }
      },
      {
        "name": "speaker",
        "type": "text",
        "id": "dlg:speaker",
        "slot": "speaker",
        "font": 20.0,
        "layout": {
          "preset": "top_left",
          "anchors": [0, 0, 0, 0],
          "offsets": { "left": 24, "top": 16, "right": 776, "bottom": 36 }
        }
      },
      {
        "name": "body",
        "type": "text",
        "id": "dlg:text",
        "slot": "body",
        "font": 18.0,
        "mode": "wrap",
        "lines": 3,
        "layout": {
          "preset": "top_left",
          "anchors": [0, 0, 0, 0],
          "offsets": { "left": 24, "top": 44, "right": 776, "bottom": 98 }
        }
      },
      {
        "name": "options",
        "type": "list",
        "slot": "options",
        "max": 5,
        "axis": "y",
        "spacing": 28,
        "layout": {
          "preset": "top_left",
          "anchors": [0, 0, 0, 0],
          "offsets": { "left": 24, "top": 100, "right": 776, "bottom": 128 }
        },
        "item": {
          "name": "row",
          "type": "rect",
          "layout": {
            "preset": "top_left",
            "anchors": [0, 0, 0, 0],
            "offsets": { "left": 0, "top": 0, "right": 752, "bottom": 28 }
          },
          "children": [
            {
              "name": "marker",
              "type": "image",
              "id": "dlg:marker$i",
              "texture": "dialogue_marker",
              "when": "selected",
              "layout": {
                "preset": "top_left",
                "anchors": [0, 0, 0, 0],
                "offsets": { "left": -12, "top": 6, "right": -4, "bottom": 14 }
              }
            },
            {
              "name": "label",
              "type": "text",
              "id": "dlg:opt$i",
              "slot": "text",
              "font": 18.0,
              "layout": {
                "preset": "top_left",
                "anchors": [0, 0, 0, 0],
                "offsets": { "left": 0, "top": 0, "right": 752, "bottom": 18 }
              }
            }
          ]
        }
      },
      {
        "name": "hint",
        "type": "text",
        "id": "dlg:hint",
        "slot": "hint",
        "font": 14.0,
        "mode": "wrap",
        "lines": 3,
        "layout": {
          "preset": "top_right",
          "anchors": [1, 0, 1, 0],
          "offsets": { "left": -808, "top": 210, "right": -24, "bottom": 252 }
        }
      },
      {
        "name": "continue",
        "type": "image",
        "id": "dlg:continue",
        "texture": "dialogue_continue",
        "layout": {
          "preset": "bottom_left",
          "anchors": [0, 1, 0, 1],
          "offsets": { "left": 24, "top": -32, "right": 40, "bottom": -16 }
        }
      }
    ]
  }
}
