# Rust build output
engine/target/
# 诊断/临时构建用的旁路 target 目录（如 target-diag）
engine/target-*/
xtask/target/

# On-demand toolchain cache: zig (wasm 侧 Lua C 编译需要)，由 scripts/zig-toolchain.ps1 下载
engine/.tools/

# Generated release copies and profiling/screenshot output
/artifacts/

# 本地基线（WP0 性能阶梯、editor 基线、engine 对外符号面基准）。全部只在本机生成与比对，
# 不入库；出处与可比性裁定见 baselines/README.md。
/baselines/

# IDE and OS files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
.dbg/
.cargo-target/
.tools/

# Per-project working directory: resource database, import cache, save data
**/.cache/
**/.data/

# Game project runtime temp: editor autosave/crash-recovery snapshots
**/.temp/

# Test-generated debug logs (thumbnail_stress etc.)
**/thumb_debug.log

# Game API build output
examples/**/builds/

# 第三方游戏的对标参考图（版权不授权再分发；只在本机看，禁止进 assets/ 与发行包）
# 清单与出处见 examples/game_jhyt/docs/53-江湖有田-星露谷场景分层参考图集.md
examples/game_jhyt/references/

# Python bytecode cache
__pycache__/
*.py[cod]

# 目验/探针的一次性输出（clippy 读数、离屏截图、tm_probe 系列）。门的本体在
# engine/crates/**/examples 与 support/ 下，不受这条影响。
engine/*.txt
engine/*.png

# 局部门复验用的旁路快照目录（如 .tmp_m66_verify/），一次性、不入库
/.tmp_*/
